[ {
  "name" : "acls_list",
  "description" : "List ACLs, filtered by principal, resource type/name, pattern, operation, permission and host",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha", "beta" ]
      },
      "principal" : {
        "type" : "string",
        "description" : "Principal (e.g. User:alice; a bare name gets the User: prefix)"
      },
      "resourceType" : {
        "type" : "string",
        "description" : "Resource type (default ANY)",
        "enum" : [ "TOPIC", "GROUP", "CLUSTER", "TRANSACTIONAL_ID", "DELEGATION_TOKEN", "USER", "ANY" ]
      },
      "resourceName" : {
        "type" : "string",
        "description" : "Resource name (matched according to patternType)"
      },
      "patternType" : {
        "type" : "string",
        "description" : "Pattern type (default ANY; MATCH: literal, prefixed and * bindings that apply to this resource)",
        "enum" : [ "LITERAL", "PREFIXED", "MATCH", "ANY" ]
      },
      "operation" : {
        "type" : "string",
        "description" : "Operation (default ANY)",
        "enum" : [ "ALL", "READ", "WRITE", "CREATE", "DELETE", "ALTER", "DESCRIBE", "CLUSTER_ACTION", "DESCRIBE_CONFIGS", "ALTER_CONFIGS", "IDEMPOTENT_WRITE", "CREATE_TOKENS", "DESCRIBE_TOKENS", "ANY" ]
      },
      "permission" : {
        "type" : "string",
        "description" : "Permission (default ANY)",
        "enum" : [ "ALLOW", "DENY", "ANY" ]
      },
      "host" : {
        "type" : "string",
        "description" : "Host (default all)"
      },
      "filter" : {
        "type" : "string",
        "description" : "Principal or resource name filter (regex, partial match)"
      },
      "limit" : {
        "type" : "integer",
        "description" : "Maximum number of items to return (default 100)",
        "minimum" : 1,
        "maximum" : 5000,
        "default" : 100
      }
    },
    "required" : [ "cluster" ]
  },
  "annotations" : {
    "readOnlyHint" : true,
    "destructiveHint" : false
  }
}, {
  "name" : "acls_explain",
  "description" : "Explain whether a principal may perform an operation on a resource under Kafka authorizer rules (ALLOW/DENY and why)",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha", "beta" ]
      },
      "principal" : {
        "type" : "string",
        "description" : "Principal (e.g. User:alice; a bare name gets the User: prefix)"
      },
      "operation" : {
        "type" : "string",
        "description" : "Operation",
        "enum" : [ "ALL", "READ", "WRITE", "CREATE", "DELETE", "ALTER", "DESCRIBE", "CLUSTER_ACTION", "DESCRIBE_CONFIGS", "ALTER_CONFIGS", "IDEMPOTENT_WRITE", "CREATE_TOKENS", "DESCRIBE_TOKENS" ]
      },
      "resourceType" : {
        "type" : "string",
        "description" : "Resource type",
        "enum" : [ "TOPIC", "GROUP", "CLUSTER", "TRANSACTIONAL_ID", "DELEGATION_TOKEN", "USER" ]
      },
      "resourceName" : {
        "type" : "string",
        "description" : "Resource name (kafka-cluster for CLUSTER)"
      },
      "host" : {
        "type" : "string",
        "description" : "Client IP (default *: only ACLs whose host is * match)"
      },
      "superUsers" : {
        "type" : "array",
        "description" : "Known super users (e.g. User:admin); used when the broker returns super.users as hidden",
        "items" : {
          "type" : "string"
        }
      },
      "allowEveryoneIfNoAclFound" : {
        "type" : "boolean",
        "description" : "The broker's allow.everyone.if.no.acl.found value; used when the broker returns it as hidden (assumed false if omitted)"
      }
    },
    "required" : [ "cluster", "principal", "operation", "resourceType", "resourceName" ]
  },
  "annotations" : {
    "readOnlyHint" : true,
    "destructiveHint" : false
  }
}, {
  "name" : "acls_who_can_access_topic",
  "description" : "Show who can access a topic (ALLOW), who is explicitly denied (DENY), and the super users",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha", "beta" ]
      },
      "topic" : {
        "type" : "string",
        "description" : "Topic name"
      },
      "operation" : {
        "type" : "string",
        "description" : "Operation (default READ and WRITE)",
        "enum" : [ "ALL", "READ", "WRITE", "CREATE", "DELETE", "ALTER", "DESCRIBE", "CLUSTER_ACTION", "DESCRIBE_CONFIGS", "ALTER_CONFIGS", "IDEMPOTENT_WRITE", "CREATE_TOKENS", "DESCRIBE_TOKENS" ]
      },
      "superUsers" : {
        "type" : "array",
        "description" : "Known super users (e.g. User:admin); used when the broker returns super.users as hidden",
        "items" : {
          "type" : "string"
        }
      },
      "allowEveryoneIfNoAclFound" : {
        "type" : "boolean",
        "description" : "The broker's allow.everyone.if.no.acl.found value; used when the broker returns it as hidden (assumed false if omitted)"
      }
    },
    "required" : [ "cluster", "topic" ]
  },
  "annotations" : {
    "readOnlyHint" : true,
    "destructiveHint" : false
  }
}, {
  "name" : "acls_principal_permissions",
  "description" : "Group the ACLs that apply to a principal by resource and summarize the effective ALLOW/DENY operations",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha", "beta" ]
      },
      "principal" : {
        "type" : "string",
        "description" : "Principal (e.g. User:alice; a bare name gets the User: prefix)"
      },
      "includeWildcardPrincipal" : {
        "type" : "boolean",
        "description" : "Also include User:* bindings (default true)"
      },
      "filter" : {
        "type" : "string",
        "description" : "Resource name filter (regex, partial match)"
      },
      "limit" : {
        "type" : "integer",
        "description" : "Maximum number of resources to return (default 100)",
        "minimum" : 1,
        "maximum" : 5000,
        "default" : 100
      }
    },
    "required" : [ "cluster", "principal" ]
  },
  "annotations" : {
    "readOnlyHint" : true,
    "destructiveHint" : false
  }
}, {
