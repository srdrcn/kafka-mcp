}, {
  "name" : "acls_create",
  "description" : "WRITE: Create ACLs: a single binding or a preset (producer, consumer, streams); returns the created bindings",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha" ]
      },
      "principal" : {
        "type" : "string",
        "description" : "Principal (e.g. User:alice; a bare name gets the User: prefix)"
      },
      "preset" : {
        "type" : "string",
        "description" : "Preset (requires topic; do not pass resourceType/resourceName/operation)",
        "enum" : [ "producer", "consumer", "streams" ]
      },
      "resourceType" : {
        "type" : "string",
        "description" : "Resource type (required without preset)",
        "enum" : [ "TOPIC", "GROUP", "CLUSTER", "TRANSACTIONAL_ID", "DELEGATION_TOKEN", "USER" ]
      },
      "resourceName" : {
        "type" : "string",
        "description" : "Resource name (required without preset; kafka-cluster for CLUSTER)"
      },
      "patternType" : {
        "type" : "string",
        "description" : "Pattern type (default LITERAL)",
        "enum" : [ "LITERAL", "PREFIXED" ]
      },
      "operation" : {
        "type" : "string",
        "description" : "Operation (required without preset)",
        "enum" : [ "ALL", "READ", "WRITE", "CREATE", "DELETE", "ALTER", "DESCRIBE", "CLUSTER_ACTION", "DESCRIBE_CONFIGS", "ALTER_CONFIGS", "IDEMPOTENT_WRITE", "CREATE_TOKENS", "DESCRIBE_TOKENS" ]
      },
      "permission" : {
        "type" : "string",
        "description" : "Permission (default ALLOW; presets are ALLOW only)",
        "enum" : [ "ALLOW", "DENY" ]
      },
      "host" : {
        "type" : "string",
        "description" : "Host (default *)"
      },
      "topic" : {
        "type" : "string",
        "description" : "Preset topic (input topic for streams)"
      },
      "group" : {
        "type" : "string",
        "description" : "consumer preset: consumer group (required)"
      },
      "transactionalId" : {
        "type" : "string",
        "description" : "producer preset: transactional.id (optional)"
      },
      "applicationId" : {
        "type" : "string",
        "description" : "streams preset: application.id (required)"
      },
      "outputTopic" : {
        "type" : "string",
        "description" : "streams preset: output topic (optional; WRITE, DESCRIBE)"
      }
    },
    "required" : [ "cluster", "principal" ]
  },
  "annotations" : {
    "readOnlyHint" : false,
    "destructiveHint" : false
  }
}, {
  "name" : "quotas_update",
  "description" : "WRITE: Set or remove client quotas (user, clientId, ip; <default> supported); returns the before/after values",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha" ]
      },
      "user" : {
        "type" : "string",
        "description" : "User (<default> for the default user)"
      },
      "clientId" : {
        "type" : "string",
        "description" : "client.id (<default> for the default)"
      },
      "ip" : {
        "type" : "string",
        "description" : "IP address (<default> for the default); cannot be combined with user/clientId"
      },
      "set" : {
        "type" : "object",
        "description" : "Quotas to set: key → number (e.g. {\"producer_byte_rate\": 1048576}). Keys: producer_byte_rate, consumer_byte_rate, request_percentage, controller_mutation_rate; connection_creation_rate for ip"
      },
      "remove" : {
        "type" : "array",
        "description" : "Quota keys to remove",
        "items" : {
          "type" : "string"
        }
      }
    },
    "required" : [ "cluster" ]
  },
  "annotations" : {
    "readOnlyHint" : false,
    "destructiveHint" : false
  }
}, {
  "name" : "acls_delete",
  "description" : "WRITE: Delete ACLs matching the filter (principal, resourceType, resourceName required); returns the deleted bindings",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha" ]
      },
      "principal" : {
        "type" : "string",
        "description" : "Principal (e.g. User:alice; a bare name gets the User: prefix)"
      },
      "resourceType" : {
        "type" : "string",
        "description" : "Resource type",
        "enum" : [ "TOPIC", "GROUP", "CLUSTER", "TRANSACTIONAL_ID", "DELEGATION_TOKEN", "USER" ]
      },
      "resourceName" : {
        "type" : "string",
        "description" : "Resource name (kafka-cluster for CLUSTER)"
      },
      "patternType" : {
        "type" : "string",
        "description" : "Pattern type (default LITERAL; ANY: all patterns with this name)",
        "enum" : [ "LITERAL", "PREFIXED", "ANY" ]
      },
      "operation" : {
        "type" : "string",
        "description" : "Operation (default ANY)",
        "enum" : [ "ALL", "READ", "WRITE", "CREATE", "DELETE", "ALTER", "DESCRIBE", "CLUSTER_ACTION", "DESCRIBE_CONFIGS", "ALTER_CONFIGS", "IDEMPOTENT_WRITE", "CREATE_TOKENS", "DESCRIBE_TOKENS", "ANY" ]
      },
      "permission" : {
        "type" : "string",
        "description" : "Permission (default ANY)",
        "enum" : [ "ALLOW", "DENY", "ANY" ]
      },
      "host" : {
        "type" : "string",
        "description" : "Host (default all)"
      }
    },
    "required" : [ "cluster", "principal", "resourceType", "resourceName" ]
  },
  "annotations" : {
    "readOnlyHint" : false,
    "destructiveHint" : true
  }
} ]
