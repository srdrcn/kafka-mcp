[ {
  "name" : "acls_list",
  "description" : "ACL'leri listeler; principal, kaynak tipi/adı, desen, işlem, izin ve host'a göre filtreler",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster adı",
        "enum" : [ "alpha", "beta" ]
      },
      "principal" : {
        "type" : "string",
        "description" : "Principal (ör. User:alice; sadece ad verilirse User: eklenir)"
      },
      "resourceType" : {
        "type" : "string",
        "description" : "Kaynak tipi (varsayılan ANY)",
        "enum" : [ "TOPIC", "GROUP", "CLUSTER", "TRANSACTIONAL_ID", "DELEGATION_TOKEN", "USER", "ANY" ]
      },
      "resourceName" : {
        "type" : "string",
        "description" : "Kaynak adı (patternType'a göre eşleşir)"
      },
      "patternType" : {
        "type" : "string",
        "description" : "Desen tipi (varsayılan ANY; MATCH: bu kaynağa uygulanan literal, prefixed ve * binding'leri)",
        "enum" : [ "LITERAL", "PREFIXED", "MATCH", "ANY" ]
      },
      "operation" : {
        "type" : "string",
        "description" : "İşlem (varsayılan ANY)",
        "enum" : [ "ALL", "READ", "WRITE", "CREATE", "DELETE", "ALTER", "DESCRIBE", "CLUSTER_ACTION", "DESCRIBE_CONFIGS", "ALTER_CONFIGS", "IDEMPOTENT_WRITE", "CREATE_TOKENS", "DESCRIBE_TOKENS", "ANY" ]
      },
      "permission" : {
        "type" : "string",
        "description" : "İzin (varsayılan ANY)",
        "enum" : [ "ALLOW", "DENY", "ANY" ]
      },
      "host" : {
        "type" : "string",
        "description" : "Host (varsayılan tümü)"
      },
      "filter" : {
        "type" : "string",
        "description" : "Principal ya da kaynak adı filtresi (regex, kısmi eşleşme)"
      },
      "limit" : {
        "type" : "integer",
        "description" : "En fazla kaç kayıt dönsün (varsayılan 100)",
        "minimum" : 1,
        "maximum" : 5000,
        "default" : 100
      }
    },
    "required" : [ "cluster" ]
  },
  "annotations" : {
    "readOnlyHint" : true,
    "destructiveHint" : false
  }
