      "version" : {
        "type" : "string",
        "description" : "Silinecek versiyon numarası ya da latest"
      },
      "permanent" : {
        "type" : "boolean",
        "description" : "Kalıcı sil, geri alınamaz (varsayılan false: soft delete)"
      }
