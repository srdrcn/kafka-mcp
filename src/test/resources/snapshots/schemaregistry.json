[ {
  "name" : "subjects_list",
  "description" : "Schema Registry subject adlarını listeler (sıralı); deleted=true soft-delete edilmişleri de getirir",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster adı",
        "enum" : [ "alpha" ]
      },
      "filter" : {
        "type" : "string",
        "description" : "Ad filtresi (regex, kısmi eşleşme; büyük/küçük harf duyarsız için (?i))"
      },
      "limit" : {
        "type" : "integer",
        "description" : "En fazla kaç kayıt dönsün (varsayılan 100)",
        "minimum" : 1,
        "maximum" : 5000,
        "default" : 100
      },
      "deleted" : {
        "type" : "boolean",
        "description" : "Soft-delete edilmiş subject'leri de getir (varsayılan false)"
      }
    },
    "required" : [ "cluster" ]
  },
  "annotations" : {
    "readOnlyHint" : true,
    "destructiveHint" : false
  }
}, {
