}, {
  "name" : "schemas_get",
  "description" : "Subject versiyonundaki şemayı getirir: id, versiyon, schemaType, referanslar ve şema metni (AVRO/JSON girintili)",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster adı",
        "enum" : [ "alpha" ]
      },
      "subject" : {
        "type" : "string",
        "description" : "Subject adı"
      },
      "version" : {
        "type" : "string",
        "description" : "Versiyon numarası ya da latest (varsayılan latest)"
      },
      "maxChars" : {
        "type" : "integer",
        "description" : "Şema metni için en fazla karakter (varsayılan 20000); aşan kısım kesilir",
        "minimum" : 200,
        "maximum" : 1000000,
        "default" : 20000
      }
    },
    "required" : [ "cluster", "subject" ]
  },
  "annotations" : {
    "readOnlyHint" : true,
    "destructiveHint" : false
  }
}, {
  "name" : "schemas_diff",
