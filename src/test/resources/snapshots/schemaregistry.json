[ {
  "name" : "subjects_list",
  "description" : "List Schema Registry subject names (sorted); deleted=true also returns soft-deleted ones",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha" ]
      },
      "filter" : {
        "type" : "string",
        "description" : "Name filter (regex, partial match; use (?i) for case-insensitive)"
      },
      "limit" : {
        "type" : "integer",
        "description" : "Maximum number of items to return (default 100)",
        "minimum" : 1,
        "maximum" : 5000,
        "default" : 100
      },
      "deleted" : {
        "type" : "boolean",
        "description" : "Also return soft-deleted subjects (default false)"
      }
    },
    "required" : [ "cluster" ]
  },
  "annotations" : {
    "readOnlyHint" : true,
    "destructiveHint" : false
  }
}, {
  "name" : "subjects_for_topic",
  "description" : "Find the subjects of a topic (<topic>-key/-value and <topic>-<RecordName>) with the latest version, id and type of each",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha" ]
      },
      "topic" : {
        "type" : "string",
        "description" : "Topic name"
      }
    },
    "required" : [ "cluster", "topic" ]
  },
  "annotations" : {
    "readOnlyHint" : true,
    "destructiveHint" : false
  }
}, {
  "name" : "schemas_versions_list",
  "description" : "List the version numbers of a subject; with deleted=true soft-deleted versions are included and marked",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha" ]
      },
      "subject" : {
        "type" : "string",
        "description" : "Subject name"
      },
      "deleted" : {
        "type" : "boolean",
        "description" : "Also return soft-deleted versions (default false)"
      }
    },
    "required" : [ "cluster", "subject" ]
  },
  "annotations" : {
    "readOnlyHint" : true,
    "destructiveHint" : false
  }
}, {
  "name" : "schemas_get",
  "description" : "Get the schema of a subject version: id, version, schemaType, references and schema text (AVRO/JSON pretty-printed)",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha" ]
      },
      "subject" : {
        "type" : "string",
        "description" : "Subject name"
      },
      "version" : {
        "type" : "string",
        "description" : "Version number or latest (default latest)"
      },
      "maxChars" : {
        "type" : "integer",
        "description" : "Maximum number of characters of the schema text (default 20000); the rest is truncated",
        "minimum" : 200,
        "maximum" : 1000000,
        "default" : 20000
      }
    },
    "required" : [ "cluster", "subject" ]
  },
  "annotations" : {
    "readOnlyHint" : true,
    "destructiveHint" : false
  }
}, {
  "name" : "schemas_diff",
  "description" : "Compare two schema versions: field-level diff and compatibility hint for AVRO, line diff for JSON/PROTOBUF",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha" ]
      },
      "subject" : {
        "type" : "string",
        "description" : "Subject name"
      },
      "fromVersion" : {
        "type" : "string",
        "description" : "Old version (default: the version before toVersion)"
      },
      "toVersion" : {
        "type" : "string",
        "description" : "New version or latest (default latest)"
      }
    },
    "required" : [ "cluster", "subject" ]
  },
  "annotations" : {
    "readOnlyHint" : true,
    "destructiveHint" : false
  }
}, {
  "name" : "schemas_register",
  "description" : "WRITE: Register a schema under a subject; returns its id and version, or the SR message for an incompatible (409) or invalid (422) schema",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha" ]
      },
      "subject" : {
        "type" : "string",
        "description" : "Subject name (e.g. <topic>-value)"
      },
      "schema" : {
        "type" : "string",
        "description" : "Schema text (Avro or JSON Schema JSON, .proto content for PROTOBUF)"
      },
      "schemaType" : {
        "type" : "string",
        "description" : "Schema type (default AVRO)",
        "enum" : [ "AVRO", "JSON", "PROTOBUF" ]
      },
      "references" : {
        "type" : "array",
        "description" : "Schema references (optional)",
        "items" : {
          "type" : "object",
          "properties" : {
            "name" : {
              "type" : "string",
              "description" : "Reference name (full type name for Avro, file/URL name for JSON/PROTOBUF)"
            },
            "subject" : {
              "type" : "string",
              "description" : "Referenced subject"
            },
            "version" : {
              "type" : "integer",
              "description" : "Referenced version"
            }
          },
          "required" : [ "name", "subject", "version" ]
        }
      }
    },
    "required" : [ "cluster", "subject", "schema" ]
  },
  "annotations" : {
    "readOnlyHint" : false,
    "destructiveHint" : false
  }
}, {
  "name" : "schemas_delete_version",
  "description" : "WRITE: Delete a schema version (soft); permanent=true deletes it permanently (soft-deleting it first if needed)",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha" ]
      },
      "subject" : {
        "type" : "string",
        "description" : "Subject name"
      },
      "version" : {
        "type" : "string",
        "description" : "Version number to delete or latest"
      },
      "permanent" : {
        "type" : "boolean",
        "description" : "Delete permanently, cannot be undone (default false: soft delete)"
      }
    },
    "required" : [ "cluster", "subject", "version" ]
  },
  "annotations" : {
    "readOnlyHint" : false,
    "destructiveHint" : true
  }
}, {
  "name" : "schemas_compatibility_get",
  "description" : "Get the compatibility level: subject level, global level and which one applies",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha" ]
      },
      "subject" : {
        "type" : "string",
        "description" : "Subject name (if omitted, only the global level)"
      }
    },
    "required" : [ "cluster" ]
  },
  "annotations" : {
    "readOnlyHint" : true,
    "destructiveHint" : false
  }
}, {
  "name" : "schemas_compatibility_check",
  "description" : "Test whether a schema is compatible with a subject version without registering it; returns the detailed SR messages",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha" ]
      },
      "subject" : {
        "type" : "string",
        "description" : "Subject name"
      },
      "schema" : {
        "type" : "string",
        "description" : "Schema text (Avro or JSON Schema JSON, .proto content for PROTOBUF)"
      },
      "schemaType" : {
        "type" : "string",
        "description" : "Schema type (default AVRO)",
        "enum" : [ "AVRO", "JSON", "PROTOBUF" ]
      },
      "version" : {
        "type" : "string",
        "description" : "Version to check against or latest (default latest)"
      },
      "references" : {
        "type" : "array",
        "description" : "Schema references (optional)",
        "items" : {
          "type" : "object",
          "properties" : {
            "name" : {
              "type" : "string",
              "description" : "Reference name (full type name for Avro, file/URL name for JSON/PROTOBUF)"
            },
            "subject" : {
              "type" : "string",
              "description" : "Referenced subject"
            },
            "version" : {
              "type" : "integer",
              "description" : "Referenced version"
            }
          },
          "required" : [ "name", "subject", "version" ]
        }
      }
    },
    "required" : [ "cluster", "subject", "schema" ]
  },
  "annotations" : {
    "readOnlyHint" : true,
    "destructiveHint" : false
  }
}, {
  "name" : "schemas_compatibility_set",
  "description" : "WRITE: Change the compatibility level of a subject (or the global level if omitted); returns the old and new value",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha" ]
      },
      "subject" : {
        "type" : "string",
        "description" : "Subject name (if omitted, the global level is changed)"
      },
      "level" : {
        "type" : "string",
        "description" : "New compatibility level",
        "enum" : [ "BACKWARD", "BACKWARD_TRANSITIVE", "FORWARD", "FORWARD_TRANSITIVE", "FULL", "FULL_TRANSITIVE", "NONE" ]
      }
    },
    "required" : [ "cluster", "level" ]
  },
  "annotations" : {
    "readOnlyHint" : false,
    "destructiveHint" : false
  }
} ]
