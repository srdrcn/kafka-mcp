      },
      "subject" : {
        "type" : "string",
        "description" : "Subject adı"
      },
      "fromVersion" : {
        "type" : "string",
        "description" : "Eski versiyon (varsayılan: toVersion'dan önceki versiyon)"
      },
      "toVersion" : {
        "type" : "string",
        "description" : "Yeni versiyon ya da latest (varsayılan latest)"
      }
    },
    "required" : [ "cluster", "subject" ]
  },
  "annotations" : {
    "readOnlyHint" : true,
    "destructiveHint" : false
  }
}, {
  "name" : "schemas_register",
  "description" : "YAZMA: Subject'e şema kaydeder, id ve versiyonu döner; uyumsuz (409) ya da geçersiz (422) şemada SR mesajını verir",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster adı",
        "enum" : [ "alpha" ]
      },
      "subject" : {
        "type" : "string",
        "description" : "Subject adı (ör. <topic>-value)"
      },
      "schema" : {
        "type" : "string",
        "description" : "Şema metni (Avro ya da JSON Schema JSON'u, PROTOBUF için .proto içeriği)"
      },
      "schemaType" : {
        "type" : "string",
        "description" : "Şema tipi (varsayılan AVRO)",
        "enum" : [ "AVRO", "JSON", "PROTOBUF" ]
      },
      "references" : {
        "type" : "array",
        "description" : "Şema referansları (opsiyonel)",
        "items" : {
          "type" : "object",
          "properties" : {
            "name" : {
              "type" : "string",
              "description" : "Referans adı (Avro'da tam tip adı, JSON/PROTOBUF'ta dosya/URL adı)"
            },
            "subject" : {
              "type" : "string",
              "description" : "Referans verilen subject"
            },
            "version" : {
              "type" : "integer",
              "description" : "Referans verilen versiyon"
            }
          },
          "required" : [ "name", "subject", "version" ]
        }
      }
    },
    "required" : [ "cluster", "subject", "schema" ]
  },
  "annotations" : {
    "readOnlyHint" : false,
    "destructiveHint" : false
  }
}, {
  "name" : "schemas_delete_version",
