[ {
  "name" : "messages_consume",
  "description" : "Read messages without a consumer group or commit: from latest/earliest/offset/timestamp, key/value/header filters, format decoding",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha", "beta" ]
      },
      "topic" : {
        "type" : "string",
        "description" : "Topic name"
      },
      "partition" : {
        "type" : "integer",
        "description" : "Partition (all partitions if omitted)",
        "minimum" : 0
      },
      "from" : {
        "type" : "string",
        "description" : "Start position (default latest = the last maxRecords records; does not wait for new data)",
        "enum" : [ "earliest", "latest", "offset", "timestamp" ]
      },
      "offset" : {
        "type" : "integer",
        "description" : "Start offset for from=offset (applied to every selected partition)",
        "minimum" : 0
      },
      "timestamp" : {
        "type" : "string",
        "description" : "Start time for from=timestamp: ISO-8601 (e.g. 2025-01-31T10:00:00Z) or epoch ms"
      },
      "keyRegex" : {
        "type" : "string",
        "description" : "Key regex filter (partial match on the decoded text)"
      },
      "valueRegex" : {
        "type" : "string",
        "description" : "Value regex filter (partial match on the decoded text)"
      },
      "headerKey" : {
        "type" : "string",
        "description" : "Only records that carry this header"
      },
      "headerValueRegex" : {
        "type" : "string",
        "description" : "Regex for the headerKey value (requires headerKey)"
      },
      "format" : {
        "type" : "string",
        "description" : "Value format (default string)",
        "enum" : [ "string", "json", "hex", "long", "avro" ],
        "default" : "string"
      },
      "keyFormat" : {
        "type" : "string",
        "description" : "Key format (default string)",
        "enum" : [ "string", "json", "hex", "long", "avro" ],
        "default" : "string"
      },
      "maxValueChars" : {
        "type" : "integer",
        "description" : "Maximum characters per value/key; longer values are truncated (default 4096)",
        "minimum" : 16,
        "maximum" : 100000,
        "default" : 4096
      },
      "maxScan" : {
        "type" : "integer",
        "description" : "Maximum records to scan with filters or from=latest (default 10000)",
        "minimum" : 1,
        "maximum" : 100000,
        "default" : 10000
      },
      "maxRecords" : {
        "type" : "integer",
        "description" : "Maximum number of records to read (default 50, max 500)",
        "minimum" : 1,
        "maximum" : 500,
        "default" : 50
      }
    },
    "required" : [ "cluster", "topic" ]
  },
  "annotations" : {
    "readOnlyHint" : true,
    "destructiveHint" : false
  }
}, {
