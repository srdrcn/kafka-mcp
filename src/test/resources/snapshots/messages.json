[ {
  "name" : "messages_consume",
  "description" : "Topic'ten mesaj okur (group'suz, commit'siz): latest/earliest/offset/timestamp, key/value/header filtresi, format çözme",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster adı",
        "enum" : [ "alpha", "beta" ]
      },
      "topic" : {
        "type" : "string",
        "description" : "Topic adı"
      },
      "partition" : {
        "type" : "integer",
        "description" : "Partition (boşsa tüm partition'lar)",
        "minimum" : 0
      },
      "from" : {
        "type" : "string",
        "description" : "Başlangıç (varsayılan latest = son maxRecords kayıt; yeni veri beklenmez)",
        "enum" : [ "earliest", "latest", "offset", "timestamp" ]
      },
      "offset" : {
        "type" : "integer",
        "description" : "from=offset için başlangıç offset'i (seçilen her partition'a uygulanır)",
        "minimum" : 0
      },
      "timestamp" : {
        "type" : "string",
        "description" : "from=timestamp için başlangıç zamanı: ISO-8601 (ör. 2025-01-31T10:00:00Z) ya da epoch ms"
      },
      "keyRegex" : {
        "type" : "string",
        "description" : "Key regex filtresi (çözülmüş metinde kısmi eşleşme)"
      },
      "valueRegex" : {
        "type" : "string",
        "description" : "Value regex filtresi (çözülmüş metinde kısmi eşleşme)"
      },
      "headerKey" : {
        "type" : "string",
        "description" : "Sadece bu header'ı taşıyan kayıtlar"
      },
      "headerValueRegex" : {
        "type" : "string",
        "description" : "headerKey değeri için regex (headerKey ile birlikte)"
      },
      "format" : {
        "type" : "string",
        "description" : "Value formatı (varsayılan string)",
        "enum" : [ "string", "json", "hex", "long", "avro" ],
        "default" : "string"
      },
      "keyFormat" : {
        "type" : "string",
        "description" : "Key formatı (varsayılan string)",
        "enum" : [ "string", "json", "hex", "long", "avro" ],
        "default" : "string"
      },
      "maxValueChars" : {
        "type" : "integer",
        "description" : "Value/key için en fazla karakter; fazlası kesilir (varsayılan 4096)",
        "minimum" : 16,
        "maximum" : 100000,
        "default" : 4096
      },
      "maxScan" : {
        "type" : "integer",
        "description" : "Filtrede/latest'te taranacak en fazla kayıt (varsayılan 10000)",
        "minimum" : 1,
        "maximum" : 100000,
        "default" : 10000
      },
      "maxRecords" : {
        "type" : "integer",
        "description" : "Okunacak en fazla kayıt (varsayılan 50, en fazla 500)",
        "minimum" : 1,
        "maximum" : 500,
        "default" : 50
      }
    },
    "required" : [ "cluster", "topic" ]
  },
  "annotations" : {
    "readOnlyHint" : true,
    "destructiveHint" : false
  }
