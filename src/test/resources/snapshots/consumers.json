  "name" : "consumer_groups_offsets_reset",
  "description" : "WRITE: Move the group's offsets on a topic to earliest/latest/offset/timestamp/shift; the group must be Empty (no active members)",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "cluster" : {
        "type" : "string",
        "description" : "Cluster name",
        "enum" : [ "alpha" ]
      },
      "group" : {
        "type" : "string",
        "description" : "Consumer group id"
      },
      "topic" : {
        "type" : "string",
        "description" : "Topic name"
      },
      "partitions" : {
        "type" : "array",
        "description" : "Partition numbers (default: all partitions of the topic)",
        "items" : {
          "type" : "integer"
        }
      },
      "to" : {
        "type" : "string",
        "description" : "Target: earliest, latest, offset, timestamp or shift",
        "enum" : [ "earliest", "latest", "offset", "timestamp", "shift" ]
      },
      "offset" : {
        "type" : "integer",
        "description" : "Target offset for to=offset",
        "minimum" : 0
      },
      "timestamp" : {
        "type" : "string",
        "description" : "Time for to=timestamp (ISO-8601 or epoch ms)"
      },
      "shiftBy" : {
        "type" : "integer",
        "description" : "Amount added to the current committed offset for to=shift (can be negative)"
      }
    },
    "required" : [ "cluster", "group", "topic", "to" ]
  },
  "annotations" : {
    "readOnlyHint" : false,
    "destructiveHint" : true
  }
